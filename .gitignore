# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Excalidraw runtime assets — vendored from node_modules at Vite buildStart;
# rebuildable, must not be in git history (issue #352).
/public/excalidraw-assets/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
playwright-report/
test-results/
test-tmp-native/

# Python
__pycache__/
*.pyc
.superpowers/
docs/superpowers/
.claude/settings.local.json
.claude/iterate-state.md
.claude/iterate-state-*.md
.claude/spec*.md
.claude/spec*.txt
.e2e-native.pid
*.review.yaml
*.review.json

# Bench fixtures are generated under `src-tauri/target/bench-fixtures/` (already
# covered by `src-tauri/.gitignore`'s `/target/` rule). They are never tracked
# in the working tree because the `mdownreview-cli` scanner picks up
# `.review.{yaml,json}` files and would surface them as real review state.
# Test fixtures intentionally use the `.review.yaml.fixture` suffix instead so
# they look like data, not sidecars.

# Tauri externalBin staging — populated by release.yml from build artefacts
src-tauri/binaries/mdownreview-cli-*
!src-tauri/binaries/.gitkeep

# test-exploratory-e2e skill runtime artefacts
.claude/test-exploratory-e2e/runs/
.claude/test-exploratory-e2e/known-findings.json
.claude/test-exploratory-loop/runs/

# iterate-loop / iterate-one-issue skill runtime artefacts
.claude/iterate-loop/runs/
.claude/retrospectives/

# merge-pr-loop skill runtime artefacts (_*.json, _*.txt are per-PR caches;
# runs/ holds per-loop digests + retros — both regenerated, never committed)
.claude/merge-pr-loop/_*.json
.claude/merge-pr-loop/_*.txt
.claude/merge-pr-loop/runs/

# Scheduling system runtime lock — regenerated automatically
.claude/scheduled_tasks.lock

