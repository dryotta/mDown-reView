@@ -45,7 +45,7 @@ export function MarkdownViewer({ content, filePath }: Props) {
-  const [theme, setTheme] = useState<"light" | "dark">("light");
+  const [theme, setTheme] = useState<"light" | "dark">(() => detectInitialTheme());
   const remarkPlugins = useMemo(() => REMARK_PLUGINS, []);
-  const rehypePlugins = useMemo(() => buildRehypePlugins({ theme }), [theme]);
+  const rehypePlugins = useMemo(() => buildRehypePlugins({ theme, lazy: true }), [theme]);

@@ -100,3 +100,12 @@ export function MarkdownViewer({ content, filePath }: Props) {
+  // Re-load lazy KaTeX when the doc starts containing math (saves the chunk
+  // download on math-free documents).
+  const hasMath = useMemo(() => HAS_MATH_RE.test(content), [content]);
+  useEffect(() => {
+    if (!hasMath || katexImported.current) return;
+    void import("rehype-katex").then((m) => {
+      rehypeKatexRef.current = m.default;
+      katexImported.current = true;
+    });
+  }, [hasMath]);

